# LLM (SiliconFlow, OpenAI-compatible)
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=deepseek-ai/DeepSeek-V4-Flash
LLM_API_KEY=__PUT_YOUR_KEY_HERE__
LLM_MAX_CONCURRENCY=16

# Post-graph enrichments
AUTO_ATTACK=1
AUTO_ROUTES=1
# M6a external-input identification after extraction (identification.json)
AUTO_INPUTS=1
# M6b per-input surface export after graph/attack/routes (information/AS-*.json)
AUTO_SURFACES=1
# Top-N attack-path LLM triage (overlay only; 0=off). Unset = on when LLM_API_KEY is set.
# AUTO_ATTACK_AI=1
# ATTACK_AI_MAX_PATHS=20
# ATTACK_AI_DAILY_PER_JOB=8
# CBM git snapshot (index_repository does not require git)
# CBM_GIT=1
# CBM_GIT_MAX_FILES=20000
# AUTO_GRAPHEXT=1

# IDA Pro：可留空。Docker 把安装拷到 deploy/docker/ida-drop/（或 data/ida/）即可自动识别。
# 仍可用 IDA_DIR 指向已有安装；IDA_DROP_DIR 覆盖投放目录（容器内默认 /opt/ida-drop）
IDA_DIR=
IDA_DROP_DIR=
IDA_WORKERS=3
IDA_TIMEOUT=1800

# M2 decompile (1 = run headless IDA export automatically after extraction)
AUTO_DECOMPILE=1

# M2b naming recovery (optional; both flow through to the headless IDA export)
# FLIRT_SIGS: "1" = apply every fwgraph_*.sig in <sig root>/<proc>/
#             (built by libc-sigs/build_sig.sh), or a comma list of short
#             .sig names. Empty/0 = off.
#             sig 根目录解析顺序：IDA_SIG_DIR -> idadir("sig") -> $IDA_DIR/sig
FLIRT_SIGS=
# IDA_SIG_DIR 仅在 sig 目录不在 <IDA_DIR>/sig 时才需要设置
# IDA_SIG_DIR=
# LUMINA_ENABLED=1 pulls Lumina metadata during export. NOTE: with this
# install's license the server rejects the pull ("lumina: bad signature"),
# so leave it off here; see docs/m2b-notes.md.
LUMINA_ENABLED=0

# CBM (codebase-memory-mcp)；留空 = 先查 PATH，再兜底 ~/.local/bin/codebase-memory-mcp
CBM_BIN=
# Above this many pseudocode files, use CBM fast mode: retain structural
# nodes/calls/usages and omit corpus-wide similarity/semantic edges.
CBM_FULL_INDEX_MAX_FILES=50000

# Paths（一般无需设置：默认按仓库布局推导 —— fwgraph/ 根目录与其下的 data/）
# FWGRAPH_ROOT=
# FWGRAPH_DATA=

# Orchestrator
ORCH_HOST=0.0.0.0
ORCH_PORT=8000
ORCH_TOKEN=
# 自签证书（ORCH_SSL=1 且 data/tls 下无证书时生成；按需填部署机的 IP/DNS）
ORCH_CERT_CN=localhost
ORCH_CERT_SANS=IP:127.0.0.1,DNS:localhost
# =1 时若未设置 ADMIN_INITIAL_PASSWORD 则启动拒绝（避免默认口令引导 admin）
FWGRAPH_STRICT_SECRETS=0

# EMBA (M1 extraction)
# EMBA_BACKEND=auto|script|docker
#   script = 开发机 sudo ./emba（要本机克隆的 EMBA_DIR）
#   docker = 官方镜像（compose 交付，需先 pull embeddedanalyzer/emba:2.0.3a）
#   auto   = 容器内走 docker（官方镜像）
EMBA_BACKEND=auto
EMBA_IMAGE=embeddedanalyzer/emba:2.0.3a
# 留空 = <仓库根>/emba（与 fwgraph/ 同级）；docker 后端可空
EMBA_DIR=
EMBA_PROFILE=extract-only.emba
EMBA_TIMEOUT=7200
EMBA_SUDO_PASSWORD=

# M7 qemu-user coverage trace (needs: apt-get install qemu-user-binfmt)
# QEMU_BIN_DIR        qemu-user 二进制所在目录（默认 /usr/bin）
# TRACE_RUN_TIMEOUT   per coverage run hard cap, seconds (default 60; a full
#                     trace is 2 runs + readiness/settle, well under 5 min)
# TRACE_HOLD_SECONDS  settle time before/after the trigger request (default 2)
# TRACE_SUDO_PASSWORD sudo for chroot/mount/kill (falls back to
#                     EMBA_SUDO_PASSWORD, then sudo -n)
TRACE_RUN_TIMEOUT=60
TRACE_HOLD_SECONDS=2
TRACE_SUDO_PASSWORD=

# 沙箱后端（Phase 2 起生效）：docker | userns | none，默认 docker
#   docker —— fuzz/frida/trace 的不可信固件代码在 fwgraph-sandbox 容器内运行
#   组件级覆盖：FUZZ_SANDBOX_BACKEND / FRIDA_SANDBOX_BACKEND / TRACE_SANDBOX_BACKEND
#   docker 或镜像不可用时的兜底：fuzz/frida 回退宿主直跑并在结果 meta 写中文
#   警告；trace 回退原有 userns/root 裁决（行为不变）
# 镜像构建（仓库根目录）：docker build -f deploy/docker/Dockerfile.sandbox -t fwgraph-sandbox:local .
SANDBOX_BACKEND=docker
# SANDBOX_IMAGE=fwgraph-sandbox:local
