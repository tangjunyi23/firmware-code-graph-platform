0 00 00 00 00 00 00 00 00 00 00 00 08 62 00  .............b.\n0020: 02 00 01 00 00 00 00 00 00 00 00 00 00 00 00 00  ................\n- \"\\xffSMB\" + cmd 0x72 + status(4B=0) + flags 0x18 + flags2 0x0000c853","stream":true,"block":0}

