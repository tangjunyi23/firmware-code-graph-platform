# vulnagent 配置模板（键与 src/config.js 实际读取的一致）
# 复制为 .env 后填写；进程环境变量的优先级高于 .env。

# fwgraph orchestrator 连接
FWGRAPH_BASE_URL=http://127.0.0.1:8000
FWGRAPH_TOKEN=
FWGRAPH_JOB_ID=
# 解包根目录（<root>/<job_id>/，fw_browse_firmware 工具 jail 在其中）；
# 留空 = 相对本仓库布局的 ../fwgraph/data/extracted
FWGRAPH_EXTRACTED_ROOT=

# LLM 网关
LLM_BASE_URL=http://127.0.0.1:3456/v1
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
# 留空 = 不显式传 temperature（由 agent.json/服务端默认决定）
LLM_TEMPERATURE=
# anthropic（默认，/messages）| openai（/chat/completions）
LLM_API_STYLE=anthropic
LLM_THINKING=0
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_MS=120000
